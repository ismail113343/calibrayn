# Copy to .env and fill in. NEVER commit .env.

# hf_inference | hf_local | ollama | openai
LLM_PROVIDER=hf_local

# local = refuse any provider that sends notes off this machine
# remote_allowed = permit hosted providers (demos only)
PRIVACY_MODE=local

HF_TOKEN=
HF_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=

DATA_DIR=data
DATABASE_PATH=data/calibrayn.db
